From d582f8f13d700d8e39714d3a8f11eb4bd2bc69f0 Mon Sep 17 00:00:00 2001
From: Yusuke Endoh <mame@ruby-lang.org>
Date: Wed, 28 Oct 2026 22:55:06 +0900
Subject: [PATCH] Fix a heap buffer overflow in case mapping of the sharp s

The case_map functions of ISO-8859-x and Windows-125x map the sharp s
(0xDF) to two bytes but checked for only one byte of room in the output
buffer, so they wrote one byte past the buffer. Check for two bytes.

Reported-by: Stephan Lipp <Stephan@Adalogics.com>
Co-Authored-By: Claude Mythos 5.1 <noreply@anthropic.com>
diff --git a/enc/iso_8859_1.c b/enc/iso_8859_1.c
index 78ea1fba600582..8e0264d20c0a5d 100644
--- a/enc/iso_8859_1.c
+++ b/enc/iso_8859_1.c
@@ -265,7 +265,7 @@ case_map(OnigCaseFoldType* flagP, const OnigUChar** pp,
   OnigUChar *to_start = to;
   OnigCaseFoldType flags = *flagP;
 
-  while (*pp < end && to < to_end) {
+  while (*pp < end && to_end - to > 1) {
     code = *(*pp)++;
     if (code == SHARP_s) {
       if (flags & ONIGENC_CASE_UPCASE) {
